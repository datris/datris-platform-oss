# Datris Platform - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# AI Provider API Keys
# These are used by vault-init.sh to seed the Vault secrets on first startup.
# After that, manage keys via the Datris UI Secrets tab.
#
# The platform defaults to Anthropic. An API key is required.
# To use a different provider, update docker/config/application.yaml:
#   ai.provider and ai.aiSecretName.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
