# Datris Platform - Environment Variables
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env

# AI Provider API Keys (at least one required for AI features)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Ollama local model (default: qwen2.5:14b-instruct)
# OLLAMA_MODEL=qwen2.5:14b-instruct

# Optional: Embedding provider for vector search (default: openai)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
